#!/bin/sh
set -eu

if [ "$#" -ne 2 ]; then
    echo "usage: verify-arm-elf <executable|shared> <file>" >&2
    exit 2
fi

case "$1" in
    executable)
        expected_type=EXEC
        ;;
    shared)
        expected_type=DYN
        ;;
    *)
        echo "verify-arm-elf: unsupported ELF type: $1" >&2
        exit 2
        ;;
esac

header=$(readelf -h "$2")

printf '%s\n' "$header" | grep -Eq 'Class:[[:space:]]+ELF32$'
printf '%s\n' "$header" | grep -Eq 'Machine:[[:space:]]+ARM$'
printf '%s\n' "$header" | grep -Eq "Type:[[:space:]]+$expected_type([[:space:]]|$)"
