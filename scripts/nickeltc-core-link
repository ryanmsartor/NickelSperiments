#!/bin/sh
set -eu

workspace=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
local_target="$workspace/.toolchains/nickeltc-root/tc/arm-nickel-linux-gnueabihf"
output=libretro.so
version_script=
objects=
libraries=

while [ "$#" -gt 0 ]; do
    case "$1" in
        -o)
            output=$2
            shift 2
            ;;
        --version-script)
            version_script=$2
            shift 2
            ;;
        *.o)
            objects="$objects $1"
            shift
            ;;
        -lpthread)
            libraries="$libraries $1"
            shift
            ;;
        *)
            echo "nickeltc-core-link: unsupported argument: $1" >&2
            exit 2
            ;;
    esac
done

version_option=
if [ -n "$version_script" ]; then
    version_option="--version-script=$version_script"
fi

if [ ! -d "$local_target" ]; then
    compiler=arm-nickel-linux-gnueabihf-g++
    if ! command -v "$compiler" >/dev/null 2>&1; then
        echo "nickeltc-core-link: $compiler is not available" >&2
        exit 127
    fi
    soname=${output##*/}
    compiler_version_option=
    if [ -n "$version_script" ]; then
        compiler_version_option="-Wl,--version-script=$version_script"
    fi
    # Word splitting is intentional; repository object paths contain no spaces.
    # shellcheck disable=SC2086
    exec "$compiler" -shared -Wl,--no-undefined -Wl,-soname,"$soname" \
        $compiler_version_option -o "$output" $objects $libraries \
        -static-libgcc -static-libstdc++ -lz -lm
fi

target="$local_target"
gcc="$target/lib/gcc/arm-nickel-linux-gnueabihf/4.9.4"
sysroot="$target/arm-nickel-linux-gnueabihf/sysroot"
tools="$target/arm-nickel-linux-gnueabihf/bin"

# Word splitting is intentional; repository object paths contain no spaces.
# shellcheck disable=SC2086
exec "$workspace/scripts/nickeltc-exec" "$tools/ld.bfd.x86_64" \
    --sysroot="$sysroot" --eh-frame-hdr --hash-style=gnu --no-undefined \
    -shared -X -m armelf_linux_eabi -soname "$(basename "$output")" \
    $version_option -o "$output" \
    -L"$gcc" -L"$target/arm-nickel-linux-gnueabihf/lib" \
    -L"$sysroot/lib" -L"$sysroot/usr/lib" "$gcc/crtbeginS.o" $objects \
    -Bstatic -lstdc++ -Bdynamic $libraries \
    -lz -lm -lgcc_s -lc -lgcc_s "$gcc/crtendS.o"
